# Docker Registry Configuration
# =================================

# Domain Configuration
REGISTRY_DOMAIN=registry.yourdomain.com
REGISTRY_PORT=443
REGISTRY_HTTP_PORT=80

# Security Configuration
REGISTRY_HTTP_SECRET=CHANGE_THIS_TO_RANDOM_SECRET_STRING

# Timezone
TIMEZONE=UTC

# Cloudflare R2 Storage Configuration
# Get these from your Cloudflare dashboard: https://dash.cloudflare.com/
R2_ACCESS_KEY_ID=0d2c57a9c323a3f1a082527af6da5170
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET=your-registry-bucket
R2_REGION=auto
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ENDPOINT=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com

# Optional: Enable encryption at rest
R2_ENCRYPT=true
R2_SECURE=true

# Authentication
# Admin credentials (used for initial htpasswd generation)
REGISTRY_ADMIN_USER=admin
REGISTRY_ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Rate Limiting (requests per second per IP)
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=20

# DDoS Protection Settings
MAX_CONNECTIONS_PER_IP=10
CLIENT_BODY_TIMEOUT=10s
CLIENT_HEADER_TIMEOUT=10s
KEEPALIVE_TIMEOUT=65s

# Fail2ban Configuration
FAIL2BAN_MAXRETRY=5
FAIL2BAN_FINDTIME=600
FAIL2BAN_BANTIME=3600

# Logging
LOG_LEVEL=info
